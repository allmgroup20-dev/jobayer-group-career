{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SITE_NAME": "YouTube Earner Worker",
    "SITE_URL": "https://youtube.earner.workers.dev",
    "GOOGLE_CLIENT_ID": "403109702719-febj7lgvrlb8am6vh39e31k2lk5cfato.apps.googleusercontent.com",
    "WHATSAPP_VERIFY_ENABLED": "false",
    "RELAY_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jgcareer-db",
      "database_id": "3e54502f-3cc2-4529-a082-3019726a7784"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "6ee0dd4bc9b147feb8400759e6ce33be"
    }
  ]
}
