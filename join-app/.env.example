# Copy this to .env.local for local development (`next dev`).
# JWT_SECRET MUST be identical to the main platform worker's JWT_SECRET so
# sessions/tokens stay interoperable (same account across both sites).
JWT_SECRET=your-secret-key-here-change-in-production
SITE_NAME=Jobayer Group Join
SITE_URL=https://youtube.offer.dev
# Same Google OAuth Client ID used by the main platform (career.jobayergroup.com).
# The join domain (youtube.offer.dev) must be added to this client's
# "Authorized JavaScript origins" in Google Cloud Console or Google login
# will fail with origin_mismatch.
GOOGLE_CLIENT_ID=403109702719-febj7lgvrlb8am6vh39e31k2lk5cfato.apps.googleusercontent.com
WHATSAPP_VERIFY_ENABLED=false
