# Copy this to .env.local for local development (`next dev`).
# JWT_SECRET is a strong random value set as a Workers secret on the deployed
# worker. It only needs to be unique — the join app only validates its own
# session tokens (account unification with the main platform happens via the
# shared google_id in D1, not via shared tokens).
JWT_SECRET=your-secret-key-here-change-in-production
SITE_NAME=Jobayer Group Join
SITE_URL=https://youtube.allmgroup20.workers.dev
# Same Google OAuth Client ID used by the main platform (career.jobayergroup.com).
# The join domain (https://youtube.allmgroup20.workers.dev) must be added to
# this client's "Authorized JavaScript origins" in Google Cloud Console or
# Google login will fail with origin_mismatch.
GOOGLE_CLIENT_ID=403109702719-febj7lgvrlb8am6vh39e31k2lk5cfato.apps.googleusercontent.com
WHATSAPP_VERIFY_ENABLED=false
